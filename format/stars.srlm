# todo: read star count from lore (i dont have anything to test :c)
return [];

total_star_count = 0;
if (total_star_count == 0) return [];

remaining_stars = 5;
stars = [" "];

blue_star_count = Math.clamp(total_star_count - 10, 0, remaining_stars);
remaining_stars -= blue_star_count;

if (blue_star_count > 0) for (i : 1..blue_star_count) {
  stars += {
    text: "✪",
    color: "aqua"
  };
}

pink_star_count = Math.clamp(total_star_count - 5, 0, remaining_stars);
remaining_stars -= pink_star_count;
if (pink_star_count > 0) for (i : 1..pink_star_count) {
  stars += {
    text: "✪",
    color: "pink"
  };
}

orange_star_count = Math.clamp(total_star_count, 0, remaining_stars);
remaining_stars -= orange_star_count;
if (orange_star_count > 0) for (i : 1..orange_star_count) {
  stars += {
    text: "✪",
    color: "orange"
  };
}

return stars;