
stat_icon_key = match {
    "stat_icon" in this -> stat_icon,
    else -> String.snake_case(stat_name),
};

potential_stat_icon = ::format::stat_icon::(stat_icon_key);

stat_icon = if (potential_stat_icon) {
    potential_stat_icon
} else {
    "?"
};

return {text: (stat_icon + " " + stat_name), color: stat_color };
