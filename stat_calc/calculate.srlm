::stat_calc::init_base::{ stats, meta };
is_dungeon_item = ("dungeon_item" in data && (data.dungeon_item == 1)) || meta.categories.contains("dungeon");
dungeon_stats = {};
if (is_dungeon_item) ::stat_calc::init_base::{ stats: dungeon_stats, meta };

for (entry : [
    "star_bonus",
    "enchant_bonus",
    "dpc_bonus",
    "polarvoid_bonus",
    "hpb_bonus",
    "aow_bonus",
    "aop_bonus",
    "ffd_bonus",
    "reforge_bonus",
    "booster_bonus"
]) {
    ::stat_calc::<entry>::{
        extra_stats,
        bonus_stats,
        stats,
        data
    };
}
if (is_dungeon_item) {
    for (entry : [
        "enchant_bonus",
        "dpc_bonus",
        "polarvoid_bonus",
        "hpb_bonus",
        "aow_bonus",
        "aop_bonus",
        "ffd_bonus",
        "reforge_bonus",
        "booster_bonus",
        "dungeon_bonus"
    ]) {
        ::stat_calc::<entry>::{
            extra_stats: {},
            bonus_stats: {},
            stats: dungeon_stats,
            data
        };
    }
}

::utils::meta_or_optional::({ field: "gem_slots", ...this }).ifPresent(| gem_slots | {
    ::stat_calc::gem_bonuses::{ ...this };
});
