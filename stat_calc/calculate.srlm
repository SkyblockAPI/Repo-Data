::stat_calc::init_base::{ stats, meta, data };
if (is_dungeon_item) ::stat_calc::init_base::{ stats: dungeon_stats, meta };

for (entry : [
    "bsb_bonus", 
    "star_bonus",
    "enchant_bonus",
    "dpc_bonus",
    "polarvoid_bonus",
    "hpb_bonus",
    "aow_bonus",
    "aop_bonus",
    "ffd_bonus",
    "reforge_bonus",
    "booster_bonus",
    "apply_rounding",
]) {
    ::stat_calc::<entry>::{
        extra_stats,
        bonus_stats,
        stats,
        data,
        is_dungeon_item
    };
}
if (is_dungeon_item) {
    for (entry : [
        "bsb_bonus",
        "enchant_bonus",
        "dpc_bonus",
        "polarvoid_bonus",
        "hpb_bonus",
        "aow_bonus",
        "aop_bonus",
        "ffd_bonus",
        "reforge_bonus",
        "booster_bonus",
        "apply_rounding",
        "dungeon_bonus"
    ]) {
        ::stat_calc::<entry>::{
            extra_stats: {},
            bonus_stats: {},
            stats: dungeon_stats,
            data,
            is_dungeon_item
        };
    }
}

::utils::meta_or_optional::({ field: "gem_slots", ...this }).ifPresent(| gem_slots | {
    ::stat_calc::gem_bonuses::{ ...this };
});
