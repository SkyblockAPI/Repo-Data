call("stat_calc/init_base", {
    stats,
    meta
});

for (entry : [
    "star_bonus",
    "enchant_bonus",
    "dpc_bonus",
    "polarvoid_bonus",
    "hpb_bonus",
    "aow_bonus",
    "aop_bonus",
    "ffd_bonus",
    "reforge_bonus"
]) {
    ::stat_calc::<entry>::{
        bonus_stats,
        stats,
        data
    };
}

::utils::meta_or_optional::({ field: "gem_slots", ...this }).ifPresent(| gem_slots | {
    call("stat_calc/gem_bonuses", {
        bonus_stats,
        stats,
        gem_slots
    });
});
