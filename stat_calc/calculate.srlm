call("stat_calc/init_base", {
    stats,
    meta
});
call("stat_calc/star_bonus", {
    stats,
    meta,
    data
});
call("stat_calc/enchant_bonus", {
    bonus_stats,
    stats,
    data
});
call("stat_calc/hpb_bonus", {
    bonus_stats,
    stats,
    data
});
call("stat_calc/aow_bonus", {
    bonus_stats,
    stats,
    data
});
call("stat_calc/aop_bonus", {
    bonus_stats,
    stats,
    data
});
call("stat_calc/ffd_bonus", {
    bonus_stats,
    stats,
    data
});
call("stat_calc/reforge_bonus", {
    bonus_stats,
    stats,
    data
});

call("utils/meta_or_optional", { field: "gem_slots", ...this }).ifPresent(| gem_slots | {
    call("stat_calc/gem_bonuses", {
        bonus_stats,
        stats,
        gem_slots
    });
});
