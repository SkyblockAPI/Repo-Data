|bonus_stats, stats, data|
# Dungeon Item Stats
if (!is_dungeon_item) return;

not_affected_by_cata_level = [
  "magic_find", "true_defense", "critical_chance", "attack_speed", "ferocity", "ability_damage", "health_regen", "swing_range",
];
not_affected_by_stars = [
  "health_regen", "swing_range"
];

dungeon_level_bonus_lut = static("stat_calc/dungeon_level_lut");
dungeon_level_bonus = dungeon_level_bonus_lut.bonuses[Math.clamp(::profile::skill_level::(this.profile, "catacombs"), 0, 50)] / 100;

total_star_count = if ("upgrade_level" in data) {
  Math.clamp(data.upgrade_level, 0, 5)
} else 0;

medallion_bonus = 0;

if (::profile::catacombs::(this.profile, "has_medallion", false)) {
  medallion_bonus = Math.clamp(1 + Math.floor(Math.log10(::profile::catacombs::(this.profile, "secret_count", 0))), 0, 5) / 100;
}

for (stat_entry : Objects.entries(stats)) {
  stat = stat_entry.key;

  stats[stat] *= 1 + (
    if (not_affected_by_stars.contains(stat)) {
      0
    } else {
      (total_star_count * 0.1)
    } + 
    if (not_affected_by_cata_level.contains(stat)) {
      0
    } else {
      dungeon_level_bonus
    } + medallion_bonus
  );
}
