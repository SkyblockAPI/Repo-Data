if (!data.gems) return;

gem_stats = static("stat_calc/gem_stat_lut");

for (i = 0; (i < meta.gem_slots.length); i+=1) {
  gem_slot = meta.gem_slots[i];
  if (!data.gems[gem_slot.id]) continue;
  slot_quality = String.lowercase(data.gems[gem_slot.id]);
  slot_contents = if (gem_stats[gem_slot.type]) {
    gem_slot.type
  } else {
    String.lowercase(data.gems[gem_slot.id + "_gem"])
  };
  gem_stat = gem_stats[slot_contents];
  item_rarity = String.lowercase(Rarity.stack());
  gem_amount = call("stat_calc/gem_bonus_lut", {
    quality: slot_quality,
    gem: slot_contents,
    rarity: item_rarity
  });

  call("stat_calc/put_bonus", {
    amount: gem_amount, 
    color: "pink",
    stat: gem_stat,
    bonus_stats, stats
  });
};