|bonus_stats, stats, data|
if ("hot_potato_count" !in data) return;

is_sword = meta.categories.contains("sword");
is_armor = meta.categories.contains("armor");

if (is_sword) {
  call("stat_calc/put_bonus", {
    stat: "strength",
    amount: data.hot_potato_count * 2,
    color: "yellow",
    bonus_stats, stats
  });
  call("stat_calc/put_bonus", {
    stat: "damage",
    amount: data.hot_potato_count * 2,
    color: "yellow",
    bonus_stats, stats
  });
};

if (is_armor) {
  call("stat_calc/put_bonus", {
    stat: "defense",
    amount: data.hot_potato_count * 2,
    color: "yellow",
    bonus_stats, stats
  });
  call("stat_calc/put_bonus", {
    stat: "health",
    amount: data.hot_potato_count * 2,
    color: "yellow",
    bonus_stats, stats
  });
};
