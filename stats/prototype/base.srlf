|name, color, extra_stats, bonus_stats, stack, stats, dungeon_stats, stat?, suffix?|

if (!name) return;

stat = if (!stat) {
  String.snake_case(name)
} else stat;

if (!stats[stat]) return;

if (extra_stats[stat]) {
    stats[stat] += ::utils::sum::(extra_stats[stat].map(|x| { x.amount }));
}

extra = [
  name,
  ": ",
  {text: String.formatted(stats[stat]), color}
];

if (suffix) {
  extra.add({text:suffix, color});
}

if (bonus_stats[stat]) {
  for (bonus_stat : bonus_stats[stat]) {
    bonus_extra = [
      " ",
      bonus_stat.prefix,
      String.formatted(bonus_stat.amount)
    ];
    if (suffix) {
      bonus_extra += suffix;
    };
    bonus_extra += bonus_stat.suffix;
    extra.add({extra: bonus_extra, color: bonus_stat.color});
  }
};

if (dungeon_stats[stat]) {
  dungeon_extra = [
    " ",
    "(",
    String.formatted(dungeon_stats[stat])
  ];
  if (suffix) {
    dungeon_extra += suffix;
  };
  dungeon_extra += ")";
  extra.add({extra: dungeon_extra, color: "dark_gray"});
}

stack.lore.add({
  text: "",
  color: "gray",
  extra
});
