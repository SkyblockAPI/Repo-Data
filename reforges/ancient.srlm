static {
  name: "Ancient",
  description: [
    {
      text: "Ancient Bonus",
      color: "blue"
    },
    {
      text: "Grants ",
      extra: [
        { text: "+1", color: "lime" },
        " ",
        call("format/stat/combat/critical_damage"),
        " per ",
        { text: "Catacombs", color: "red"},
        " level."
      ],
      color: "gray"
    }
  ],
  stats: {
    mythic: {
      health: 7,
      defense: 7,
      strength: 35,
      crit_chance: 15,
      intelligence: 25
    },
  },
  specific_stats: |this| {
    return {
      critical_damage: ::profile::skill_level::(this.profile, "catacombs")
    }
  }
};
