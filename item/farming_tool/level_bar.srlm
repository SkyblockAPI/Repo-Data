
stack.lore.beginSection();

bar_title = {
    text: "Level ",
    color: "gray",
    extra: [
        { text: String.uFormatted(level), color: if (requires_upgrade_no_overclock) { "white" } else { "green" } }
    ]
};


if (is_max_level) {
    bar_title.extra.add({ text: " (MAX!)   ", color: "gold", bold: true });
} else {
    bar_title.extra.addAll(
        [
             { text: " -> ", color: "dark_gray" },
            { text: String.uFormatted(level + 1), color: if (requires_upgrade_no_overclock) { "gray" } else { "gold" }  },
            "   ",
        ]
    );
}


bar_title.extra.add({
    color: "dark_gray",
    extra: [
        "(",
        String.compact(Math.min(max, exp)),
        "/",
        String.compact(max),
        ")"
    ]
});

stack.lore.add(bar_title);

progress = Math.clamp(exp / max, 0, 1);

print(exp, max);
bar = [];

for (i : 0..40) {
    current_progress = i / 40;

    bar.add({ text: " ", strikethrough: true, color: if ((current_progress <= progress) && !needs_upgrade) { "lime" } else { "white" } });
}

bar.add({ text: " ", color: "white" });
bar.add({ text: String.uFormatted(Math.floor(progress * 1000) / 10), extra: [ { text: "%", color: if (!needs_upgrade) { "gold" } else { "dark_gray" }}], color: if (!needs_upgrade) { "yellow" } else { "gray" } });

stack.lore.add(bar);


if (needs_upgrade && (hoe_tier >= 3)) {
    stack.lore.add({ text: "OVERCLOCK REQUIRED!", color: "dark_aqua", bold: true });
} else if (needs_upgrade) {
    stack.lore.add({ text: "UPGRADE REQUIRED!", color: "red", bold: true });
}

stack.lore.endSection();
