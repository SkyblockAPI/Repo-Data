
stack.lore.beginSection();

levels = call("item/farming_tool/levels");

overclockes_used = call("utils/data_or_default", { field: "levelable_overclocks", data, default: 0 });
hoe_tier = call("utils/meta_or_field", { field: "hoe_tier", ...this });

max_level_overclocked = match (hoe_tier) {
   1 -> 14,
   2 -> 29,
   3 -> 40 + overclockes_used,
};

max_level = match (hoe_tier) {
   1 -> 14,
   2 -> 29,
   3 -> 40,
};

level = Math.min(data.levelable_lvl, max_level_overclocked);

exp = call("utils/data_or_default", { field: "levelable_exp", data, default: 0 });
max = levels[level];

is_max_level = level >= 50;
needs_upgrade = (data.levelable_lvl >= max_level) && !is_max_level;

stack.lore.add({
    text: "Level ",
    color: "gray",
    extra: [
        { text: String.uFormatted(level), color: if (needs_upgrade) { "white" } else { "green" } },
        { text: " -> ", color: "dark_gray" },
        { text: String.uFormatted(level + 1), color: if (needs_upgrade) { "gray" } else { "gold" }  },
        "   ",
        {
            color: "dark_gray",
            extra: [
                "(",
                String.compact(Math.min(max, exp)),
                "/",
                String.compact(max),
                ")"
            ]
        }
    ]
});

progress = exp / max;

bar = [];

for (i : 0..40) {
    bar.add({ text: " ", strikethrough: true, color: "lime" });
}

bar.add({ text: " ", color: "white" });
bar.add({ text: String.uFormatted(Math.floor(progress * 1000) / 10), extra: [ { text: "%", color: "gold" }], color: "yellow" });

stack.lore.add(bar);


if (needs_upgrade && (hoe_tier >= 3)) {
    stack.lore.add({ text: "OVERCLOCK REQUIRED!", color: "dark_aqua", bold: true });
} else {
    stack.lore.add({ text: "UPGRADE REQUIRED!", color: "red", bold: true });
}

stack.lore.endSection();
