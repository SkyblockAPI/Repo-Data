footer = [];

if (Rarity.isRecombobulated()) {
   footer += {text: "a ", obfuscated: true};
};

rarity = Rarity.stack();
footer += rarity;

if ("category" in meta) {
    if (data.dungeon_item) {
        footer += " DUNGEON";
    };
    footer += " " + String.uppercase(meta.category);
};

if (Rarity.isRecombobulated()) {
   footer += {text: " a", obfuscated: true};
};

stack.lore.add({
    extra: footer,
    color: Rarity.color(rarity),
    bold: true
});
