if ("donated_museum" in data || "soulbound" in meta) {
    if ("donated_museum" in data || String.eqIc(meta.soulbound, "coop")) {
        stack.lore.add({color: "dark_gray", extra: [{text: "* ", bold: true}, "Co-op Soulbound", {text: " *", bold: true}]});
    } else if (String.eqIc(meta.soulbound, "solo")) {
        stack.lore.add({color: "dark_gray", extra: [{text: "* ", bold: true}, "Soulbound", {text: " *", bold: true}]});
    };
};