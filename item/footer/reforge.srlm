if ("modifier" !in data) {
    call("utils/meta_or_optional", { field: "can_be_reforged", ...this }).ifPresent(| x | {
        stack.lore.add({text: "This item can be reforged!", color: "dark_gray"});
    });
    return;
};
reforge = static("reforges/" + data.modifier);

if ("description" in reforge) {
    reforge_wrap_length = if ("description_wrap" !in reforge) {
        35
    } else {
        reforge.description_wrap
    };
    stack.lore.addAll(Component.splitToLength(reforge.description, reforge_wrap_length));
    stack.lore.endSection();
} else if ("description_provider" in reforge) {
    stack.lore.addAll(Component.splitToLength(reforge.description_provider(Rarity.stack()), 35));
    stack.lore.endSection();
}
