if ("enchantments" !in data) {
    return;
};

enchantments = Objects.entries(data.enchantments);
base_enchantments = [];
has_ultimate = false;
ultimate = "";

for (current : enchantments) {
    enchantment = call("enchantments/enchant", {
        level: current.value,
        type: current.key
    });

    if ("is_legacy" in enchantment) {
        continue;
    };

    enchantment_key = Component.asString(enchantment.name);
    enchantments[enchantment_key] = enchantment;

    if (enchantment.is_ultimate) {
        ultimate = enchantment_key;
        has_ultimate = true;
        continue;
    };

    base_enchantments.add(enchantment_key);
};

always_compact = false;
if ("always_compact_enchants" in meta) {
    always_compact = true;
};

base_enchantments = Array.sorted(base_enchantments);

if (has_ultimate) {
    base_enchantments.addFirst(ultimate);
};

stack.lore.beginSection();
# ordered alphabetically, ultimate first
if ((base_enchantments.length >= 10) || always_compact) {

    base_enchantments.chunked(3).map(|base_enchantments| {
        base_enchantments.mapIndexed(| enchantment, index | {
            entry = enchantments[enchantment].name;

            if ((index + 1) < base_enchantments.length) {
                if ("extra" in entry) {
                    entry.extra = Component.join(entry.extra, ", ");
                } else {
                    entry.extra = [{text: ", "}];
                };
            };
            entry
        })
    }).forEach(stack.lore.add);

} else {
    base_enchantments.forEach(|enchantment_key| {
        enchantment = enchantments[enchantment_key];

        stack.lore.add(enchantment.name);
        if (enchantments.length <= 5) {
            stack.lore.addAll(Component.splitToLength(enchantment.description, match {
                "wrap_override" in enchantment -> enchantment.wrap_override,
                else -> 38,
            }));
        };
    });
};
stack.lore.endSection();
