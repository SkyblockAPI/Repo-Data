if ("enchantments" !in data) {
    return;
};

enchantments = Objects.entries(data.enchantments);
base_enchantments = [];
has_ultimate = false;
ultimate = "";

for (temp.enchantment = 0; Math.lt(temp.enchantment, enchantments.length); temp.enchantment = Math.add(temp.enchantment, 1)) {
    enchantment = {};
    temp.current = enchantments.get(temp.enchantment);
    enchantment.level = temp.current.value;
    include("enchantments/" + temp.current.key);
    enchantment.static_data = static("enchantments/" + temp.current.key);

    if ("name" !in enchantment) {
        enchantment.name = enchantment.static_data.name;
    };
    if ("wrap_override" in enchantment.static_data) {
        enchantment.wrap_override = enchantment.static_data.wrap_override;
    };

    temp.enchantment_key = Component.asString(enchantment.name);
    enchantments[temp.enchantment_key] = enchantment;
    if ("is_legacy" in enchantment) {
        continue;
    };

    enchantment.name = Component.asComponent(enchantment.name);
    enchantment.name.color = "blue";

    if (config.roman_numerals) {
        enchantment.name.extra = [" ", Component.asRoman(enchantment.level)];
    } else {
        enchantment.name.extra = [" ", String.uFormatted(enchantment.level)];
    };

    if ("is_ultimate" in enchantment.static_data) {
        if (enchantment.static_data.is_ultimate) {
            ultimate = temp.enchantment_key;
            has_ultimate = true;
            enchantment.name.color = "pink";
            enchantment.name.bold = true;
            continue;
        };
    };

    base_enchantments.add(temp.enchantment_key);
};

always_compact = false;
if ("always_compact_enchants" in meta) {
    always_compact = true;
};

base_enchantments = Array.sorted(base_enchantments);

if (has_ultimate) {
    base_enchantments.addFirst(ultimate);
};

stack.lore.beginSection();
# ordered alphabetically, ultimate first
if (Boolean.or(Math.gte(base_enchantments.length, 10), always_compact)) {

    base_enchantments = base_enchantments.chunked(3);

    for (temp.enchantment_line = 0; Math.lt(temp.enchantment_line, base_enchantments.length); temp.enchantment_line = Math.add(temp.enchantment_line, 1)) {

        temp.enchantments = base_enchantments.get(temp.enchantment_line);
        line = [];

        for (temp.enchantment = 0; Math.lt(temp.enchantment, temp.enchantments.length); temp.enchantment = Math.add(temp.enchantment, 1)) {
            entry = enchantments[temp.enchantments[temp.enchantment]].name;

            if (Math.lt(Math.add(temp.enchantment, 1), temp.enchantments.length)) {
                if ("extra" in entry) {
                    entry.extra = Component.join(entry.extra, ", ");
                } else {
                    entry.extra = [{text: ", "}];
                };
            };
            line.add(entry);
        };

        stack.lore.add(line);

    };

} else {
    for (temp.enchantments = 0; (temp.enchantments < base_enchantments.length); temp.enchantments += 1) {
        temp.enchantment = enchantments[base_enchantments[temp.enchantments]];

        stack.lore.add(temp.enchantment.name);
        if (enchantments.length <= 5) {
            stack.lore.addAll(Component.splitToLength(temp.enchantment.description, match {
                "wrap_override" in temp.enchantment -> temp.enchantment.wrap_override;
                else -> 38;
            }));
        };
    };
};
stack.lore.endSection();
