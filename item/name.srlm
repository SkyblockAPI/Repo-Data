reforge_name = if ("modifier" in data) {
  reforge_data = static("reforges/"+data.modifier);
  (reforge_data.name + " ")
} else {
  ""
};

name = call("utils/meta_or_field", { field: "name", ...this });

name = [reforge_name, name, stars];

stars = call("format/stars");

name.addAll(stars);

stack.name = {color: Rarity.color(Rarity.stack()), extra: name};
