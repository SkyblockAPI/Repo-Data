abilities = match {
  "abilities" in meta -> meta.abilities,
  "abilities" in this -> abilities,
  else -> return,
};

abilities.forEach(| ability | {
    stack.lore.beginSection();

    ability_trigger = if ("trigger" in ability) {
        {text: ability.trigger, color: "yellow", bold: true}
    } else {
        {}
    };

    stack.lore.add({
        text: "",
        extra: [
            {text: "Ability: ", color: "gold"},
            {text: ability.name, color: "gold"},
            {text: "  "},
            ability_trigger
        ]
    });

    stack.lore.addAll(Component.splitToLength(ability.text, 35));

    if ("mana_cost" in ability) {
        ability_mana_cost = ability.mana_cost;
        if ("enchantments" in data) {
            if ("ultimate_wise" in data.enchantments) {
                reduction = 1 - ((10 * data.enchantments.ultimate_wise) / 100);
                ability_mana_cost = (ability_mana_cost * reduction);
            };
        };

        stack.lore.add({text: "Mana Cost: ", color: "dark_gray", extra: [{text: String.uFormatted(ability_mana_cost), color: "cyan"}]});
    };

    if ("soulflow_cost" in ability) {
        stack.lore.add({text: "Soulflow Cost: ", color: "dark_gray", extra: [{text: String.uFormatted(ability.soulflow_cost), color: "cyan"}]});
    };

    if ("cooldown" in ability) {
        stack.lore.add({text: "Cooldown: ", color: "dark_gray", extra: [{text: ability.cooldown, color: "green"}]});
    };

    stack.lore.endSection();
});
