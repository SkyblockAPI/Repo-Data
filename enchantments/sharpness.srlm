static {
    name: "Sharpness",
    levels: 1..7
};
amount = match (enchantment.level) {
  <= 4 -> (5 * enchantment.level);
  else -> ((10 * enchantment.level) - 20);
}

enchantment.description = {extra: [
    "Increases melee damage dealt by ",
    {text: String.uFormatted(temp.amount), color: "lime", extra: ["%"]},
    "."
], color: "gray"};
