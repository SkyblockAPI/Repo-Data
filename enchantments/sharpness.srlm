static {
    name: "Sharpness",
    levels: 1..7
};

amount = match (level) {
  <= 4 -> (5 * level),
  else -> ((10 * level) - 20),
}

description = {extra: [
    "Increases melee damage dealt by ",
    {text: String.uFormatted(amount), color: "lime", extra: ["%"]},
    "."
], color: "gray"};

return {
    level,
    description
};