static {
    name: "Experience",
    levels: 1..5
};

amount = 12.5 * level;

description = {extra: [
    "Grants a ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "chance for mobs and ores to drop double experience."
], color: "gray"};

return {
    level,
    description
};