folder_map = static("enchantments/enchant");

path = if (folder_map[type]) {
  (folder_map[type] + "/")
} else {
  print("Could not find enchant " + type + ".");
  return;
} + type;

enchantment = call("enchantments/" + path, {
  level,
});

if ("level" !in enchantment) {
  enchantment.level = level;
};

call("utils/copy_into", {
  from: static("enchantments/" + path),
  to: enchantment
});

enchantment.name = Component.asComponent(enchantment.name);
enchantment.name.color = "blue";

if (config.roman_numerals) {
  enchantment.name.extra = [" ", Component.asRoman(enchantment.level)];
    } else {
  enchantment.name.extra = [" ", String.uFormatted(enchantment.level)];
};

if (enchantment.is_ultimate) {
  enchantment.name.color = "pink";
  enchantment.name.bold = true;
};

return enchantment;
