
crop_fortune = level * 5;

crop_fortune_name = String.snake_case(crop_type) + "_fortune";

stat_bonus_thingy = {};
stat_bonus_thingy[crop_fortune_name] = crop_fortune;

description = [
    {
        text: "Grants ",
        color: "gray",
        extra: [
            {
                color: "gold",
                extra: [
                    "+",
                    String.uFormatted(crop_fortune),
                    call("format/stat/farming/" + crop_fortune_name)
                ]
            },
            "."
        ]
    }
];

match (level) {
    4 -> {
        description.add({
            text: "Requires ",
            extra: [
                {text: "Bronze", color: "red"},
                " in a ",
                {text: crop_type + " Contest", color: "lime"},
                "!"
            ],
            color: "gray",
            do_not_split: true
        });
    },
    5 -> {
        description.add({
            text: "Requires ",
            extra: [
                {text: "Silver", color: "white"},
                " in a ",
                {text: crop_type + " Contest", color: "lime"},
                "!"
            ],
            color: "gray",
            do_not_split: true
        })
    },
}

{
    description,
    stat_bonus: stat_bonus_thingy
}
