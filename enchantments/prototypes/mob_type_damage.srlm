amount = match (level) {
    >= 4 -> (20 + (10 * (level - 4))),
    else -> (5 * level),
}

description = [{
    text: "Increases damage dealt to ",
    extra: [
        format,
        " mobs by ",
        {text: String.uFormatted(amount), color: "lime", extra: ["%", {text: ".", color: "gray"}]}
    ],
    color: "gray"
}];

return {
    level,
    description
}
