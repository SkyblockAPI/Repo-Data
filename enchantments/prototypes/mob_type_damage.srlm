temp.amount = match (enchantment.level) {
    >= 4 -> (20 + (10 * (enchantment.level - 4)));
    else -> (5 * enchantment.level);
}

enchantment.description = [{
    text: "Increases damage dealt to ",
    extra: [
        format,
        " mobs by ",
        {text: String.uFormatted(temp.amount), color: "lime", extra: ["%", {text: ".", color: "gray"}]}
    ],
    color: "gray"
}];
