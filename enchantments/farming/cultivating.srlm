static {
    levels: 1..10,
    name: "Cultivating"
};

farming_fortune = level * 2;
farming_wisdom = level;

return {
    level,
    description: {
        text: "Gain ",
        color: "gray",
        extra: [
            ::format::plus_stat::(farming_wisdom, "farming_wisdom"),
            " and ",
            ::format::plus_stat::(farming_fortune, "farming_fortune"),
            "."
        ]
    },
    stat_bonus: {
        farming_fortune,
        farming_wisdom
    }
};
