static {
    levels: 1..4,
    name: "Dedication"
};

farming_fortune = match (level) {
    1 -> 0.5,
    2 -> 0.75,
    3 -> 1,
    4 -> 2,
}

extra_stats = {};

::data::crop_types::().forEach(| crop_type | {
    milestone = ::profile::garden::crop_milestone::{ crop_type, profile};
    if (milestone > 0) {
        extra_stats[crop_type + "_fortune"] = farming_fortune * milestone;
    };
});

return {
    level,
    description: {
        text: "Grants ",
        extra: [
            {
                color: "gold",
                extra: [
                    "+",
                    String.uFormatted(farming_fortune),
                    call("format/stat/farming/farming_fortune")
                ]
            },
            " for crops, multiplied by your ",
            { text: "Garden", color: "green" },
            " milestone for that crop."
        ],
        color: "gray"
    },
    extra_stats
};
