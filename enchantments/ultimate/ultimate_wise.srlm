static {
    levels: 1..5,
    is_ultimate: true,
    name: "Ultimate Wise"
};

reduction = 10 * Math.clamp(level, 1, 5);

description = {
    text: "Reduces the ability mana cost of this item by ",
    color: "gray",
    extra: [
        { text: String.uFormatted(reduction), color: "lime", extra: ["%"] },
        "."
    ]

};

return {
    level,
    description
};