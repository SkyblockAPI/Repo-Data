static {
    levels: 1..6,
    name: "Cleave"
};

temp.percentage = Math.mul(5, enchantment.level);
temp.range = Math.add(3, Math.mul(0.5, enchantment.level));

enchantment.description = [
    {
        text: "Deals up to ",
        extra: [
            {text: String.uFormatted(temp.percentage), color: "lime"},
            {text: "%", color: "lime"},
            " of your damage dealt to other monsters within ",
            {text: String.uFormatted(temp.range), color: "lime"},
            {text: " blocks of the target."}
        ],
        color: "gray"
    }
];
enchantment.applicable = [];
