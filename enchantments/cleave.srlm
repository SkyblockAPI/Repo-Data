static {
    levels: 1..6,
    name: "Cleave"
};

percentage = 5 * enchantment.level;
range = 3 + 0.5 * enchantment.level;

enchantment.description = [
    {
        text: "Deals up to ",
        extra: [
            {text: String.uFormatted(percentage), color: "lime"},
            {text: "%", color: "lime"},
            " of your damage dealt to other monsters within ",
            {text: String.uFormatted(range), color: "lime"},
            {text: " blocks of the target."}
        ],
        color: "gray"
    }
];
enchantment.applicable = [];
