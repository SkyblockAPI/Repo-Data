static {
    levels: 1..3,
    name: "Divine Gift"
};

temp.amount = 2 * enchantment.level;

include("format/stat/magic_find");

format = {text: "+", color: format.color, extra: [
    String.uFormatted(temp.amount),
    format
]};

enchantment.description = {text: "Grants ", extra: [format, "."], color: "gray"};
