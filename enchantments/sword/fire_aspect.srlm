static {
    name: "Fire Aspect",
    levels: 1..3
};

amount = 3 * level;
seconds = if (level >= 2) {
    4
} else {
    3
};

description = {extra: [
    "Ignites your enemies for ",
    {text: String.uFormatted(seconds), color: "lime", extra: ["s", {color: "gray", text: ", "}]},
    "dealing ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "of your damage per second."
], color: "gray"};

return {
    level,
    description
};