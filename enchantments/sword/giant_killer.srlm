static {
    levels: 1..7,
    name: "Giant Killer"
};

amount = 0.1 * level;
health = 5 * level;
amount += match (level) {
    5 -> 0.1,
    6 -> 0.3,
    7 -> 0.5,
    else -> 0,
};

health += match (level) {
    5 -> 5,
    6 -> 15,
    7 -> 30,
    else -> 0,
};

description = {extra: [
    "Increases damage dealt by ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "for each percent of extra health that your target has above you up to ",
    {text: String.uFormatted(health), color: "lime", extra: ["%"]},
    "."
], color: "gray"};

return {
    level,
    description
};