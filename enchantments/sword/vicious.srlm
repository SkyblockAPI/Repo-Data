static {
    name: "Vicious",
    levels: 1..3
};

ferocity_format = call("format/stat/combat/ferocity");
ferocity_amount = 2 + level;

description = {
    color: "gray",
    extra: [
        "Grants ",
        {color: ferocity_format.color, extra: ["+", String.uFormatted(ferocity_amount), " ", ferocity_format]},
        "."
    ]
};

return {
    level,
    description,
    stat_bonus: {
        ferocity: ferocity_amount
    }
};