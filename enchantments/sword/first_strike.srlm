static {
    name: "First Strike",
    levels: 1..5
};

amount = 25 * level;

description = {extra: [
    "Increases melee damage dealt by ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "for the first hit on a mob."
], color: "gray"};

return {
    level,
    description
};