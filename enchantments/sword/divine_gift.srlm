static {
    levels: 1..3,
    name: "Divine Gift"
};

amount = 2 * level;

magic_find_symbol = call("format/stat/misc/magic_find");

format = {text: "+", color: magic_find_symbol.color, extra: [
    String.uFormatted(amount),
    " ",
    magic_find_symbol
]};

return {
    level,
    stat_bonus: {
        magic_find: amount
    },
    description: {text: "Grants ", extra: [format, "."], color: "gray"}
};