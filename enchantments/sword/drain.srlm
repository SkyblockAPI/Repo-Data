static {
    levels: 1..5,
    name: "Drain"
};

crit_damage_format = call("format/stat/combat/crit_damage");

first = {text: "100 ", color: crit_damage_format.color, extra: [crit_damage_format, " "]};
second = {text: "1,000 ", color: crit_damage_format.color, extra: [crit_damage_format]};
amount = 0.1 + level / 10;

description = {extra: [
    "Heals for ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "of your max health per ",
    first,
    "you deal per hit, up to ",
    second,
    "."
], color: "gray"};

return {
    level,
    description
};