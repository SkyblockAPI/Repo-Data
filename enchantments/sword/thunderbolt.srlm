static {
    name: "Thunderbolt",
    levels: 1..7
};

amount = match (level) {
  >= 6 -> ((level * 5) - 5),
  else -> (level * 4),
}

description = {
    color: "gray",
    extra: [
        "Every ",
        { text: "3 ", color: "red" },
        "hits on a monster, strike ",
        { text: "lightning", color: "yellow" },
        ", dealing ",
        {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
        "of the hit's damage to up to 10 monsters within 2 blocks."
    ]
};

return {
    level,
    description
};