static {
    name: "Triple-Strike",
    levels: 1..5
};

amount = 10 * level;

description = {
    color: "gray",
    extra: [
        "Increases melee damage dealt by ",
        {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
        "for the first three hits on a mob."
    ]
};

return {
    level,
    description
};