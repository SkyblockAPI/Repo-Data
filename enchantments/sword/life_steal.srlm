static {
    name: "Life Steal",
    levels: 1..5
};

amount = 2.4 * level;

stat_icons = call("format/stat_icons");

description = {extra: [
    "Heal ",
    {text: String.uFormatted(amount), color: "red", extra: [stat_icons.health]},
    " every time you hit a mob."
], color: "gray"};

return {
    level,
    description
};