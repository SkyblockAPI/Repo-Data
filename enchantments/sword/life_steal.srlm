static {
    name: "Life Steal",
    levels: 1..5
};

amount = 2.4 * level;

description = {extra: [
    "Heal ",
    {text: String.uFormatted(amount), color: "red", extra: [::format::stat_icon::("health")]},
    " every time you hit a mob."
], color: "gray"};

return {
    level,
    description
};