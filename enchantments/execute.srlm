static {
    name: "Execute",
    levels: 1..6
};

amount = match (level) {
    <= 5 -> (0.2 * level),
    6 -> 1.25,
};

description = {extra: [
    "Increases damage dealt by ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "for each percent of health missing on your target."
], color: "gray"};

return {
    level,
    description
};