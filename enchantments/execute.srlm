static {
    name: "Execute",
    levels: 1..6
};

temp.amount = match (enchantment.level) {
    <= 5 -> (0.2 * enchantment.level);
    6 -> 1.25;
};

enchantment.description = {extra: [
    "Increases damage dealt by ",
    {text: String.uFormatted(temp.amount), color: "lime", extra: ["% "]},
    "for each percent of health missing on your target."
], color: "gray"};
