static {
    levels: 1..5,
    is_ultimate: true,
    name: "Ultimate Wise"
};

temp.reduction = Math.mul(10, Math.clamp(enchantment.level, 1, 5));

enchantment.description = {
    text: "Reduces the ability mana cost of this item by ",
    color: "gray",
    extra: [
        { text: String.uFormatted(temp.reduction), color: "lime", extra: ["%"] },
        "."
    ]

};
enchantment.applicable = [];
