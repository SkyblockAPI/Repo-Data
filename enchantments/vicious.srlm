static {
    name: "Vicious",
    levels: 1..3
};

ferocity_format = call("format/stat/combat/ferocity");

description = {
    color: "gray",
    extra: [
        "Grants ",
        {color: ferocity_format.color, extra: ["+", String.uFormatted(2 + level), " ", ferocity_format]},
        "."
    ]
};

return {
    level,
    description
};