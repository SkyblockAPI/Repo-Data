static {
  levels: 1..5,
  name: "Overload",
  wrap_override: 38
};

percentage = 10 * level;
crit_percent = 1 * level;

critical_damage_format = call("format/stat/combat/critical_damage");
critical_chance_format = call("format/stat/combat/critical_chance");

return {
  level,
  description: {
    text: "Increases ",
    extra: [
      critical_damage_format,
      " by ",
      {text: String.uFormatted(crit_percent) + "%", color: "lime"},
      " and ",
      critical_chance_format,
      " by ",
      {text: String.uFormatted(crit_percent) + "%", color: "lime"},
      ". Having a Critical chance above ",
      {text: "100%", color: critical_chance_format.color},
      " grants a chance to perform a Mega Critical Hit dealing ",
      {text: String.uFormatted(percentage) + "%", color: critical_damage_format.color},
      " extra damage."
    ],
    color: "gray"
  },
  stat_bonus: {
    critical_chance: crit_percent,
    critical_damage: crit_percent
  }
};