static {
    levels: 1..2,
    name: "Flame",
    wrap_override: 35
};

seconds = 3 + (0.5 * level);
percentage = 3 * level;

description = [{
  text: "Arrows ignite your enemise for ",
  extra: [
    {text: String.uFormatted(seconds), color: "lime"},
    {text: "s", color: "lime"},
    ", dealing ",
    {text: String.uFormatted(percentage), color: "lime"},
    {text: "%", color: "lime"},
    " of your damage per second."
  ],
  color: "gray"
}];

return {
    level,
    description
};