static {
  levels: 1..4,
  name: "Snipe"
};

percentage = level * 1;
description = [{
  text: "Arrows deal ",
  extra: [
    {text: String.formatted(percentage) + "%", color: "lime"},
    " damage for every ",
    {text: "10", color: "lime"},
    " blocks traveled."
  ],
  color: "gray"
}];

return {
  level,
  description
};