static {
    name: "Prosecute",
    levels: 1..6
};

match (enchantment.level) {
    6 -> temp.amount = 1,
    5 -> temp.amount = 0.7,
    else -> temp.amount = 0.1 * enchantment.level,
};

enchantment.description = {extra: [
    "Increases damage dealt by ",
    {text: String.uFormatted(temp.amount), color: "lime", extra: ["% "]},
    "for each percent of health your target has."
], color: "gray"};
