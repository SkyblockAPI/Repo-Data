static {
    name: "Prosecute",
    levels: 1..6
};

amount = match (level) {
    6 -> 1,
    5 -> 0.7,
    else -> (0.1 * level),
};

description = {extra: [
    "Increases damage dealt by ",
    {text: String.uFormatted(amount), color: "lime", extra: ["% "]},
    "for each percent of health your target has."
], color: "gray"};

return {
    level,
    description
};