static {
    name: "Tripple-Strike",
    levels: 1..5
};

temp.amount = 10 * enchantment.level;

enchantment.description = {
    color: "gray",
    extra: [
        "Increases melee damage dealt by ",
        {text: String.uFormatted(temp.amount), color: "lime", extra: ["% "]},
        "for the first three hits on a mob."
    ]
};
