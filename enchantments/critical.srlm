static {
    levels: 1..7,
    name: "Critical"
};

temp.percentage = Math.add(Math.mul(10, enchantment.level), Math.clamp(Math.sub(Math.mul(20, Math.clamp(Math.sub(enchantment.level, 5), 0, 2)), 10), 0, 30));

enchantment.description = [{
    text: "Increases ",
    extra: [
        call("format/stat/combat/crit_damage"),
        " by ",
        {text: String.uFormatted(temp.percentage), color: "lime"},
        {text: "%", color: "lime"},
        "."
    ],
    color: "gray"
}];
enchantment.applicable = [];
