static {
    levels: 1..7,
    name: "Critical"
};

percentage = Math.mul(10, level) + Math.clamp((20 * Math.clamp(level - 5, 0, 2)) - 10, 0, 30);

description = [{
    text: "Increases ",
    extra: [
        call("format/stat/combat/crit_damage"),
        " by ",
        {text: String.uFormatted(percentage), color: "lime"},
        {text: "%", color: "lime"},
        "."
    ],
    color: "gray"
}];

return {
    level,
    description,
    stat_bonus: {
        crit_damage: percentage
    }
};