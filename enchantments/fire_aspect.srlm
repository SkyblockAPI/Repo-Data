static {
    name: "Fire Aspect",
    levels: 1..3
};

temp.amount = 3 * enchantment.level;
temp.seconds = if (enchantment.level >= 2) {
    4
} else {
    3
};

enchantment.description = {extra: [
    "Ignites your enemies for ",
    {text: String.uFormatted(temp.seconds), color: "lime", extra: ["s", {color: "gray", text: ", "}]},
    "dealing ",
    {text: String.uFormatted(temp.amount), color: "lime", extra: ["% "]},
    "of your damage per second."
], color: "gray"};
