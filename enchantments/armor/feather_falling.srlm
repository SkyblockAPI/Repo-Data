static {
    levels: 1..3,
    name: "Feather Falling",
    wrap_override: 37
};

fall_damage_safety = 1 * level;
fall_damage_reduction = 5 * level;

description = {
    text: "Increases how far you can fall before taking fall damage by ",
    extra: [
      {text: String.uFormatted(fall_damage_safety), color: "lime"},
      " and reduces fall damage by ",
      {text: String.uFormatted(fall_damage_reduction) + "%", color: "lime"},
      "."
    ],
    color: "gray"
};

return {
    level,
    description
};
