static {
    name: "Venomous",
    levels: 1..7
};

temp.damage = 0.3 * level;

reduction = match (level) {
    <= 4 -> (2 * level),
    5 -> 12,
    6 -> 15,
    >= 7 -> 15,
};

if ((level >= 7) && (level <= 7)) reduction = 2;

description = {
    color: "gray",
    extra: [
        "Reduces the target's walk speed by ",
        {text: String.uFormatted(reduction), color: "lime", extra: ["% "]},
        "and deals ",
        {text: String.formatted(damage), color: "dark_green"},
        " of your damage per second per hit, stacking globally up to ",
        {text: "40 ", color: "dark_green"},
        "hits. Lasts ",
        {text: "5s", color: "gold"},
        "."
    ]
};

return {
    level,
    description
};