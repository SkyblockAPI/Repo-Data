static {
    name: "Thunderlord",
    levels: 1..7
};

if (enchantment.level >= 6) {
    temp.amount = (enchantment.level * 10) - 10;
} else {
    temp.amount = (enchantment.level * 8);
};

enchantment.description = {
    color: "gray",
    extra: [
        "Every ",
        { text: "3 ", color: "red" },
        "hits on a monster, strike ",
        { text: "lightning", color: "yellow" },
        ", dealing ",
        {text: String.uFormatted(temp.amount), color: "lime", extra: ["% "]},
        "of the hit's damage."
    ]
};
