lore = call("utils/meta_or_default", { field: "lore", default: {} });
stats = {};
bonus_stats = {};
include("stat_calc/calculate", {
    stats,
    bonus_stats,
    data,
    meta
});

include("item/name");
include("item/headers");
include("item/stats");

include("item/enchantments");

if ("after_stats" in lore) {
    stack.lore.beginSection();
    stack.lore.addAll(lore.after_stats);
    stack.lore.endSection();
}

include("item/ability");

if ("after_ability" in lore) {
    stack.lore.beginSection();
    stack.lore.addAll(lore.after_ability);
    stack.lore.endSection();
}

call("utils/meta_or_optional", { field: "is_ingredient", ...this }).ifPresent(|value| {
    stack.lore.beginSection();
    stack.lore.add({text: "Right-click to view recipes!", color: "yellow"});
    stack.lore.endSection();
});

include("item/toolkit");
include("item/footer");

if ("item" in meta) {
    stack.item = meta.item;
}

if ("skin" in meta) {
    stack.skin = meta.skin;
};
