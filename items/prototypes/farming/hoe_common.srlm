type = "Farming Tool";

farming_data = call("item/farming_tool/farming_data");

gem_slots = [];

if (farming_data.tool_level >= 5) {
    gem_slots.add({
        "id": "PERIDOT_0",
        "type": "peridot"
    });
}
if (farming_data.tool_level >= 15) {
    gem_slots.add({
        "id": "PERIDOT_1",
        "type": "peridot"
    });
}
if (farming_data.tool_level >= 25) {
    gem_slots.add({
        "id": "PERIDOT_1",
        "type": "peridot"
    });
}
if (farming_data.tool_level == 50) {
    gem_slots.add({
        "id": "PERIDOT_1",
        "type": "peridot"
    });
}

call("stat_calc/put_stat", { stat: (call("utils/meta_or_field", { field: "crop_type", ...this }) + "_fortune"), amount: farming_data.crop_fortune, stats });
call("stat_calc/put_stat", { stat: "farming_wisdom", amount: farming_data.farming_wisdom, stats });
