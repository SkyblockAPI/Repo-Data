type = "Farming Tool";

can_be_reforged = true;
farming_data = call("item/farming_tool/farming_data");

is_farming_tool = true;

stats = if (stats) { stats } else { {} };

Array.of(call("utils/meta_or_field", { field: "crop_type", ...this })).forEach(| crop_types | {
    call("stat_calc/put_stat", { stat: (crop_types + "_fortune"), amount: farming_data.crop_fortune, stats });
});

call("stat_calc/put_stat", { stat: "farming_wisdom", amount: farming_data.farming_wisdom, stats });

include("item");
